}

model JobRateLimit {
  queue      String   @id @unique() @db.VarChar(255)
  tokens     Float
  refilledAt DateTime @map("refilled_at")

  @@map("job_rate_limits")
}

model Newsletter {
  id             String    @id @unique() @default(ulid()) @db.Char(26)
  organizationId String    @map("organization_id") @db.Char(26)
  name           String    @db.VarChar(255)
  description    String?
  replyTo        String?   @map("reply_to")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  managers     NewsletterManager[]
  subscribers  NewsletterSubscriber[]
  messages     NewsletterMessage[]

  @@index([organizationId])
  @@map("newsletters")
}

model NewsletterManager {
  id           String @id @unique() @default(ulid()) @db.Char(26)
  newsletterId String @map("newsletter_id") @db.Char(26)
  userId       String @map("user_id") @db.Char(26)
  role         String @default("OWNER") @db.VarChar(50)

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([newsletterId, userId])
  @@index([newsletterId])
  @@index([userId])
  @@map("newsletter_managers")
}

model NewsletterSubscriber {
  id                 String    @id @unique() @default(ulid()) @db.Char(26)
  newsletterId       String    @map("newsletter_id") @db.Char(26)
  email              String    @db.VarChar(255)
  name               String?   @db.VarChar(255)
  locale             String?   @db.VarChar(5)
  unsubscribeToken   String    @unique() @map("unsubscribe_token") @db.Char(64)
  // Double opt-in: when the person agreed (e.g. their registration), and when
  // they clicked the confirmation link. Only confirmed subscribers get mail.
  consentedAt        DateTime  @map("consented_at")
  confirmedAt        DateTime? @map("confirmed_at")
  confirmationToken  String?   @unique() @map("confirmation_token") @db.Char(64)
  confirmationSentAt DateTime? @map("confirmation_sent_at")
  subscribedAt       DateTime  @default(now()) @map("subscribed_at")

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([newsletterId, email])
  @@index([newsletterId])
  @@index([newsletterId, confirmedAt])
  @@map("newsletter_subscribers")
}

model NewsletterMessage {
  id             String   @id @unique() @default(ulid()) @db.Char(26)
  newsletterId   String   @map("newsletter_id") @db.Char(26)
  sentByUserId   String?  @map("sent_by_user_id") @db.Char(26)
  subject        String   @db.VarChar(255)
  body           String
  recipientCount Int      @map("recipient_count")
  sentAt         DateTime @default(now()) @map("sent_at")

  newsletter  Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sentBy      User?      @relation(fields: [sentByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attachments File[]

  @@index([newsletterId])
  @@map("newsletter_messages")
}

model ProgramItem {
  id       String  @id @unique() @default(ulid()) @db.Char(26)
  eventId  String  @map("event_id") @db.Char(26) // Prisma does not support morth
  /// ![string | Record<string, string>]
  title    Json
  /// ![string | Record<string, string>]
  details  Json?
  /// ![string | Record<string, string>]
  location Json?
  date     String?
  duration Int?
  time     String?
  color    String? @map("color")
  plan     String  @default("both")
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("program_items")
}

model ProgramPublishedDay {
