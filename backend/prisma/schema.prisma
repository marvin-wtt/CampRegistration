generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// TODO This is a workaround due to https://github.com/prisma/prisma/issues/3219
generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @unique() @default(ulid()) @db.Char(26)
  name          String    @db.VarChar(255)
  email         String    @unique() @db.VarChar(255)
  emailVerified Boolean   @default(false) @map("email_verified")
  password      String    @db.VarChar(255)
  role          Role      @default(USER)
  locale        String    @default("en-GB") @db.VarChar(5)
  locked        Boolean   @default(false)
  lastSeen      DateTime? @map("last_seen")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  eventRoles                    EventManager[]
  tokens                        Token[]
  newsletterManagers            NewsletterManager[]
  sentNewsletterMessages        NewsletterMessage[]
  sentMessages                  Message[]
  organizationMembers           OrganizationMember[]
  reviewedOrganizations         Organization[]        @relation("OrganizationReviewer")
  twoFactor                     UserTwoFactor?
  paidExpenses                  Expense[]             @relation("ExpensePaidBy")
  createdExpenses               Expense[]             @relation("ExpenseCreatedBy")
  receivedPayouts               Payout[]              @relation("PayoutRecipient")
  createdPayouts                Payout[]              @relation("PayoutCreatedBy")
  createdIncomes                Income[]              @relation("IncomeCreatedBy")
  createdPayments               Payment[]             @relation("PaymentCreatedBy")
  createdPaymentRefunds         PaymentRefund[]       @relation("PaymentRefundCreatedBy")
  postponedEventRetentionStates EventRetentionState[] @relation("EventRetentionStatePostponedBy")
  adminAccessGrants             AdminAccessGrant[]

  @@map("users")
}

enum AdminAccessScope {
  event
  newsletter
  organization
}

/// Temporary access of a system administrator to an event, newsletter or
/// organization beyond their own role. See docs/admin-access.md.
model AdminAccessGrant {
  id        String           @id @unique() @default(ulid()) @db.Char(26)
  userId    String           @map("user_id") @db.Char(26)
  scope     AdminAccessScope
  scopeId   String           @map("scope_id") @db.Char(26)
  reason    String           @db.VarChar(500)
  expiresAt DateTime         @map("expires_at")
  endedAt   DateTime?        @map("ended_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, scope, scopeId, expiresAt])
  @@index([scope, scopeId, createdAt])
  @@map("admin_access_grants")
}

model UserTwoFactor {
  userId         String    @id @map("user_id") @db.Char(26)
  secret         String    @db.Char(32)
  /// Set once the user confirmed the setup with a valid code; null while
  /// setup is pending.
  confirmedAt    DateTime? @map("confirmed_at")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recoveryCodes TwoFactorRecoveryCode[]

  @@map("user_two_factor")
}

model TwoFactorRecoveryCode {
  id        String    @id @unique() @default(ulid()) @db.Char(26)
  userId    String    @map("user_id") @db.Char(26)
  code      String    @db.VarChar(255)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  twoFactor UserTwoFactor @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("two_factor_recovery_codes")
}

enum Role {
  USER
  ADMIN
}

enum ConfirmationMode {
  AUTOMATIC
  MANUAL
}

enum OrganizationVerificationStatus {
  // Created, not yet submitted: submission waits for a published privacy notice.
  DRAFT
  PENDING
  VERIFIED
  REJECTED
}

model Organization {
  id                 String                         @id @unique() @default(ulid()) @db.Char(26)
  name               String                         @db.VarChar(255)
  verificationStatus OrganizationVerificationStatus @default(DRAFT) @map("verification_status")

  contactEmail       String  @map("contact_email") @db.VarChar(255)
  phone              String? @db.VarChar(50)
  website            String? @db.VarChar(255)
  registrationNumber String? @map("registration_number") @db.VarChar(100)

  addressStreet  String @map("address_street") @db.VarChar(255)
  addressZipCode String @map("address_zip_code") @db.VarChar(20)
  addressCity    String @map("address_city") @db.VarChar(255)
  country        String @db.Char(2)

  verificationNote String?   @map("verification_note")
  reviewNote       String?   @map("review_note")
  reviewedAt       DateTime? @map("reviewed_at")
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Char(26)
  submittedAt      DateTime? @map("submitted_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  reviewedBy  User?                    @relation("OrganizationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  events      Event[]
  newsletters Newsletter[]

  @@index([verificationStatus])
  @@index([reviewedByUserId])
  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @unique() @default(ulid()) @db.Char(26)
  organizationId String   @map("organization_id") @db.Char(26)
  userId         String?  @map("user_id") @db.Char(26)
  role           String   @default("MEMBER") @db.VarChar(50)
  invitationId   String?  @map("invitation_id") @db.Char(26)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user         User?                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invitation   OrganizationInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([invitationId])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String @id @unique() @default(ulid()) @db.Char(26)
  organizationId String @map("organization_id") @db.Char(26)
  email          String @db.VarChar(255)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  members      OrganizationMember[]

  @@index([organizationId])
  @@index([email])
  @@map("organization_invitations")
}

model Event {
  id                       String           @id @unique() @default(ulid()) @db.Char(26)
  organizationId           String           @map("organization_id") @db.Char(26)
  listed                   Boolean
  registrationOpensAt      DateTime?        @map("registration_opens_at") @db.Timestamp(0)
  registrationClosesAt     DateTime?        @map("registration_closes_at") @db.Timestamp(0)
  confirmationMode         ConfirmationMode @default(AUTOMATIC) @map("confirmation_mode")
  /// ![Array<string>]
  countries                Json
  /// ![string | Record<string, string>]
  name                     Json
  /// ![string | Record<string, string>]
  organizer                Json
  /// ![string | Record<string, string>]
  contactEmail             Json
  /// ![number | Record<string, number>]
  maxParticipants          Json
  minAge                   Int              @map("min_age")
  maxAge                   Int              @map("max_age")
  startAt                  DateTime         @map("start_at") @db.Timestamp(0)
  endAt                    DateTime         @map("end_at") @db.Timestamp(0)
  timezone                 String           @default("Europe/Berlin") @db.VarChar(64)
  /// Minor units of `currency`: one for every group, or one per group.
  /// ![number | Record<string, number>]
  price                    Json
  currency                 String           @default("EUR") @db.Char(3)
  /// ![string | Record<string, string>]
  location                 Json?
  /// ![Record<string, unknown>]
  form                     Json
  /// ![Record<string, unknown>]
  themes                   Json             @default("{}")
  /// When deleting the answers to special-category questions began, for good
  /// (docs/privacy.md, 8): no edit brings them back. Implied by
  /// `registrationDataPurgedAt`.
  sensitiveDataPurgedAt    DateTime?        @map("sensitive_data_purged_at") @db.Timestamp(0)
  /// When every registration's sensitive answers were cleared. Until then the
  /// deletion is still open and can be run again.
  sensitiveDataClearedAt   DateTime?        @map("sensitive_data_cleared_at") @db.Timestamp(0)
  /// When all registration data was deleted for good. The event never takes
  /// registrations again.
  registrationDataPurgedAt DateTime?        @map("registration_data_purged_at") @db.Timestamp(0)
  archivedAt               DateTime?        @map("archived_at")
  createdAt                DateTime?        @default(now()) @map("created_at")
  updatedAt                DateTime?        @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  eventManager         EventManager[]
  registrations        Registration[]
  rooms                Room[]
  tableTemplates       TableTemplate[]
  messageTemplates     MessageTemplate[]
  messages             Message[]
  files                File[]
  programItems         ProgramItem[]
  programPublishedDays ProgramPublishedDay[]
  tasks                Task[]
  chores               Chore[]
  choreAssignments     ChoreAssignment[]
  eventSettings        EventSetting[]
  auditLogs            AuditLog[]
  financeCategories    FinanceCategory[]
  expenses             Expense[]
  payouts              Payout[]
  incomes              Income[]
  payments             Payment[]
  finance              EventFinance?
  retentionStates      EventRetentionState[]

  @@index([organizationId])
  @@map("events")
}

// An event's finance numbering, apart from the event so handing out a number
// isn't an event edit (no `updatedAt`). Created with the event.
model EventFinance {
  eventId             String @id @map("event_id") @db.Char(26)
  /// Shown before payout numbers (`P1`); fixed once the first payout exists.
  payoutNumberPrefix  String @default("P") @map("payout_number_prefix") @db.VarChar(8)
  /// Shown before income numbers (`I1`); fixed once the first income exists.
  incomeNumberPrefix  String @default("I") @map("income_number_prefix") @db.VarChar(8)
  /// The last receipt and payout numbers handed out. Counters rather than
  /// `MAX() + 1`, so deleting the newest record never frees its number.
  lastReceiptNumber   Int    @default(0) @map("last_receipt_number")
  lastPayoutNumber    Int    @default(0) @map("last_payout_number")
  lastIncomeNumber    Int    @default(0) @map("last_income_number")
  /// Starts every transfer reference of the event (`K7MX-0042`), so transfers
  /// for several events on one bank account stay apart.
  referenceCode       String @unique() @map("reference_code") @db.Char(4)
  lastReferenceNumber Int    @default(0) @map("last_reference_number")

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  payouts Payout[]
  incomes Income[]

  @@map("event_finances")
}

model EventManager {
  id           String    @id @unique() @default(ulid()) @db.Char(26)
  eventId      String    @map("event_id") @db.Char(26)
  userId       String?   @map("user_id") @db.Char(26)
  role         String    @db.VarChar(50)
  invitationId String?   @map("invitation_id") @db.Char(26)
  expiresAt    DateTime? @map("expires_at") @db.Timestamp(0)

  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invitation    EventInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignedTasks Task[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([invitationId])
  @@map("event_managers")
}

model EventInvitation {
  id           String         @id @unique() @default(ulid()) @db.Char(26)
  email        String         @db.VarChar(255)
  eventManager EventManager[]

  @@map("event_manager_invitations")
}

enum RegistrationStatus {
  ACCEPTED
  PENDING
  WAITLISTED
}

model Registration {
  id                                 String             @id @unique() @default(ulid()) @db.Char(26)
  eventId                            String             @map("event_id") @db.Char(26)
  /// ![Record<string, unknown>]
  data                               Json
  /// ![Record<string, unknown>]
  customData                         Json?              @map("custom_data")
  // Computed fields
  firstName                          String?            @map("first_name")
  lastName                           String?            @map("last_name")
  role                               String?
  gender                             String?
  dateOfBirth                        DateTime?          @map("date_of_birth") @db.Date
  /// ![Array<string>]
  emails                             Json?
  /// ![Array<string>]
  phoneNumbers                       Json?              @map("phone_numbers")
  street                             String?
  city                               String?
  zipCode                            String?            @map("zip_code")
  country                            String?
  // The group the registration belongs to, by its country code. The address's
  // own country is `country`, and may differ.
  group                              String?            @db.VarChar(2)
  newsletterConsent                  Boolean?           @map("newsletter_consent")
  locale                             String             @default("en-GB") @db.VarChar(5)
  //
  status                             RegistrationStatus @default(PENDING)
  // What the server calculated — and the form showed — at submission, in
  // minor units of `currency`, and never changes. Null on registrations
  // predating it.
  quotedAmount                       Int?               @map("quoted_amount")
  // The currency the registration's amounts are in: its event's at
  // submission, so each amount says what it is in.
  currency                           String?            @db.Char(3)
  // Set by hand in place of the quote; what is owed is this (or the quote)
  // minus what refunds cancelled (docs/payments.md).
  amountDueOverride                  Int?               @map("amount_due_override")
  amountDueNote                      String?            @map("amount_due_note") @db.VarChar(255)
  amountDueAdjustedAt                DateTime?          @map("amount_due_adjusted_at")
  // The transfer reference (`K7MX-0042`): the event's `referenceCode` and a
  // number of the event's own.
  paymentReference                   String             @unique() @map("payment_reference") @db.VarChar(16)
  // Which privacy information this person was actually shown. Nullable because
  // registrations predating the feature were shown none — do not backfill.
  organizationPrivacyNoticeVersionId String?            @map("organization_privacy_notice_version_id") @db.Char(26)
  eventPrivacyNoticeVersionId        String?            @map("event_privacy_notice_version_id") @db.Char(26)
  platformPrivacyPolicyUpdatedAt     DateTime?          @map("platform_privacy_policy_updated_at")
  // The wording of each consent given, as shown, by answer path — proof
  // under Art. 7(1). Null on registrations predating it; do not backfill.
  /// ![Record<string, string>]
  consentTexts                       Json?              @map("consent_texts")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  event                     Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationPrivacyNotice PrivacyNoticeVersion?   @relation("RegistrationOrganizationPrivacyNotice", fields: [organizationPrivacyNoticeVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  eventPrivacyNotice        PrivacyNoticeVersion?   @relation("RegistrationEventPrivacyNotice", fields: [eventPrivacyNoticeVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bed                       Bed?
  files                     File[]
  deliveries                MessageDelivery[]
  choreAssignmentMembers    ChoreAssignmentMember[]
  payments                  Payment[]

  @@index([organizationPrivacyNoticeVersionId])
  @@index([eventPrivacyNoticeVersionId])
  // Counted per group on every registration, for its participant limit.
  @@index([eventId, group])
  @@map("registrations")
}

model Room {
  id        String @id @unique() @default(ulid()) @db.Char(26)
  eventId   String @map("event_id") @db.Char(26)
  /// ![string | Record<string, string>]
  name      Json
  sortOrder Int    @default(999) @map("sort_order")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  beds  Bed[]

  @@map("rooms")
}

model Bed {
  id             String  @id @unique @default(ulid()) @db.Char(26)
  roomId         String  @map("room_id") @db.Char(26)
  registrationId String? @unique() @map("registration_id") @db.Char(26)

  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("beds")
}

model TableTemplate {
  id      String @id @unique() @default(ulid()) @db.Char(26)
  eventId String @map("event_id") @db.Char(26)
  /// ![Record<string, unknown>]
  data    Json

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([eventId])
  @@map("table_templates")
}

model EventSetting {
  id        String    @id @unique() @default(ulid()) @db.Char(26)
  eventId   String    @map("event_id") @db.Char(26)
  key       String    @db.VarChar(100)
  /// ![Record<string, unknown>]
  data      Json
  updatedAt DateTime? @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([eventId, key])
  @@map("event_settings")
}

model Token {
  id          Int       @id @default(autoincrement())
  userId      String    @map("user_id") @db.Char(26)
  token       String    @db.VarChar(255)
  type        TokenType
  expiresAt   DateTime  @map("expires_at")
  blacklisted Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
  RESTRICTED_ACCESS
}

enum UploadStatus {
  PENDING
  READY
}

model File {
  id                  String       @id @unique() @default(ulid()) @db.Char(26)
  eventId             String?      @map("event_id") @db.Char(26) // Prisma does not support morth
  registrationId      String?      @map("registration_id") @db.Char(26) // Prisma does not support morth
  messageId           String?      @map("message_id") @db.Char(26) // Prisma does not support morth
  messageDeliveryId   String?      @map("message_delivery_id") @db.Char(26) // Prisma does not support morth
  messageTemplateId   String?      @map("message_template_id") @db.Char(26) // Prisma does not support morth
  newsletterMessageId String?      @map("newsletter_message_id") @db.Char(26) // Prisma does not support morth
  expenseId           String?      @map("expense_id") @db.Char(26) // Prisma does not support morth
  payoutId            String?      @map("payout_id") @db.Char(26) // Prisma does not support morth
  incomeId            String?      @map("income_id") @db.Char(26) // Prisma does not support morth
  name                String
  originalName        String       @map("original_name")
  field               String?
  locale              String?
  /// The group a file applies to, by its country code; null for every group.
  group               String?      @db.VarChar(2)
  type                String
  size                Int
  accessLevel         String?      @map("access_level")
  storageLocation     String       @map("storage_location")
  uploadStatus        UploadStatus @default(READY) @map("upload_status")
  encryption          String?
  createdAt           DateTime     @default(now()) @map("created_at")

  event             Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  registration      Registration?      @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  message           Message?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  messageDelivery   MessageDelivery?   @relation(fields: [messageDeliveryId], references: [id], onDelete: SetNull)
  messageTemplate   MessageTemplate?   @relation(fields: [messageTemplateId], references: [id], onDelete: SetNull)
  newsletterMessage NewsletterMessage? @relation(fields: [newsletterMessageId], references: [id], onDelete: SetNull)
  expense           Expense?           @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  payout            Payout?            @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  income            Income?            @relation(fields: [incomeId], references: [id], onDelete: SetNull)

  @@index([expenseId])
  @@index([payoutId])
  @@index([incomeId])
  @@map("files")
}

enum FinanceCategoryKind {
  EXPENSE
  INCOME
}

// Per event, never shared: see docs/finances.md. One level of grouping — a
// category with a `parentId` is a leaf, and only leaves hold records. Expense
// and income categories are separate lists, each grouped within itself.
model FinanceCategory {
  id         String              @id @unique() @default(ulid()) @db.Char(26)
  eventId    String              @map("event_id") @db.Char(26)
  kind       FinanceCategoryKind @default(EXPENSE)
  parentId   String?             @map("parent_id") @db.Char(26)
  /// ![string | Record<string, string>]
  name       Json
  position   Int                 @default(0)
  // Used categories are archived instead of deleted: hidden from the picker,
  // kept on their expenses.
  archivedAt DateTime?           @map("archived_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime?           @updatedAt @map("updated_at")

  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent   FinanceCategory?  @relation("FinanceCategoryGroup", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  children FinanceCategory[] @relation("FinanceCategoryGroup")
  expenses Expense[]
  incomes  Income[]

  @@index([eventId])
  @@index([parentId])
  @@map("finance_categories")
}

enum ExpenseType {
  EXPENSE
  REFUND
}

// Amounts are positive minor units of the event's currency; `type` carries
// the direction. Neither payer column set means event funds paid.
model Expense {
  id               String      @id @unique() @default(ulid()) @db.Char(26)
  eventId          String      @map("event_id") @db.Char(26)
  receiptNumber    Int         @map("receipt_number")
  type             ExpenseType @default(EXPENSE)
  amount           Int
  // What the receipt says, when it is in another currency; set together.
  originalAmount   Int?        @map("original_amount")
  originalCurrency String?     @map("original_currency") @db.Char(3)
  // The date on the receipt; `null` while the receipt is still to come.
  date             String?     @db.Char(10)
  description      String      @db.VarChar(255)
  // Who was paid: a shop, a bus company. Free text, for the bookkeeping.
  vendor           String?     @db.VarChar(255)
  categoryId       String?     @map("category_id") @db.Char(26)
  paidByUserId     String?     @map("paid_by_user_id") @db.Char(26)
  // A snapshot for a manager, the only identity for anyone else.
  paidByName       String?     @map("paid_by_name") @db.VarChar(255)
  createdByUserId  String?     @map("created_by_user_id") @db.Char(26)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime?   @updatedAt @map("updated_at")

  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category  FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  paidBy    User?            @relation("ExpensePaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy User?            @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  files     File[]

  @@unique([eventId, receiptNumber])
  @@index([categoryId])
  @@index([paidByUserId])
  @@index([createdByUserId])
  @@map("expenses")
}

// Money the event receives other than registration fees: grants, donations.
// See "Income" in docs/finances.md. Always shared funds, never a balance.
model Income {
  id               String    @id @unique() @default(ulid()) @db.Char(26)
  eventId          String    @map("event_id") @db.Char(26)
  number           Int
  amount           Int
  // What the grant letter says, when it is in another currency; set together.
  originalAmount   Int?      @map("original_amount")
  originalCurrency String?   @map("original_currency") @db.Char(3)
  // When the money arrived; `null` while it is promised but not yet paid.
  receivedOn       String?   @map("received_on") @db.Char(10)
  description      String    @db.VarChar(255)
  // Who gave it: a funder, a sponsor. Free text, for the bookkeeping.
  payerName        String?   @map("payer_name") @db.VarChar(255)
  categoryId       String?   @map("category_id") @db.Char(26)
  createdByUserId  String?   @map("created_by_user_id") @db.Char(26)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // The same event id: an income reads its number prefix from here.
  finance   EventFinance     @relation(fields: [eventId], references: [eventId], onDelete: Cascade, onUpdate: Cascade, map: "incomes_event_id_finance_foreign")
  category  FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy User?            @relation("IncomeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  files     File[]

  @@unique([eventId, number])
  @@index([categoryId])
  @@index([createdByUserId])
  @@map("incomes")
}

enum PayoutDirection {
  OUT
  IN
}

// A transfer between event funds and a person, never a cost: `OUT` pays
// them, `IN` is money they hand back.
model Payout {
  id                String          @id @unique() @default(ulid()) @db.Char(26)
  eventId           String          @map("event_id") @db.Char(26)
  number            Int
  recipientUserId   String?         @map("recipient_user_id") @db.Char(26)
  recipientName     String          @map("recipient_name") @db.VarChar(255)
  direction         PayoutDirection
  amount            Int
  // When the money moved; `null` while the payout is still to be made (the
  // statement is usually signed first, the transfer follows).
  paidOn            String?         @map("paid_on") @db.Char(10)
  note              String?         @db.VarChar(255)
  // Where an `OUT` payout is transferred to; all three unset otherwise. Not
  // part of the statement, so changing them never makes it outdated.
  bankAccountHolder String?         @map("bank_account_holder") @db.VarChar(255)
  bankIban          String?         @map("bank_iban") @db.VarChar(34)
  bankBic           String?         @map("bank_bic") @db.VarChar(11)
  // The recipient's signature under the statement, as SVG path data. A scan
  // of a slip signed on paper is one of `files` instead.
  signature         String?
  signedAt          DateTime?       @map("signed_at")
  // `{ content, basis }`, frozen at creation and never written again: see
  // "Frozen statements" in docs/finances.md.
  statement         Json
  createdByUserId   String?         @map("created_by_user_id") @db.Char(26)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime?       @updatedAt @map("updated_at")

  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // The same event id: a payout reads its number prefix from here.
  finance   EventFinance @relation(fields: [eventId], references: [eventId], onDelete: Cascade, onUpdate: Cascade, map: "payouts_event_id_finance_foreign")
  recipient User?        @relation("PayoutRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy User?        @relation("PayoutCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  files     File[]

  @@unique([eventId, number])
  @@index([recipientUserId])
  @@index([createdByUserId])
  @@map("payouts")
}

// Where a payment came from. Providers join `MANUAL` later (docs/payments.md).
enum PaymentSource {
  MANUAL
}

// Manual payments are recorded once the money arrived. A provider's
// checkout adds the states before `PAID`; balances count only `PAID`.
enum PaymentStatus {
  PAID
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  OTHER
}

// How money still held was settled when its registration was deleted.
enum PaymentSettlement {
  RETAINED
}

// A registration fee that came in. Outlives its registration as the
// accounting record, with its own snapshot of who paid.
model Payment {
  id              String             @id @unique() @default(ulid()) @db.Char(26)
  eventId         String             @map("event_id") @db.Char(26)
  registrationId  String?            @map("registration_id") @db.Char(26)
  source          PaymentSource      @default(MANUAL)
  status          PaymentStatus      @default(PAID)
  amount          Int
  currency        String             @db.Char(3)
  method          PaymentMethod
  // The booking date, a calendar date like `Payout.paidOn`.
  paidOn          String             @map("paid_on") @db.Char(10)
  note            String?            @db.VarChar(255)
  // The registration's name and id when the payment was recorded; the name
  // is cleared once the accounting retention period is over.
  payerName       String?            @map("payer_name") @db.VarChar(255)
  registrationRef String             @map("registration_ref") @db.Char(26)
  settlement      PaymentSettlement?
  createdByUserId String?            @map("created_by_user_id") @db.Char(26)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime?          @updatedAt @map("updated_at")

  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  registration Registration?   @relation(fields: [registrationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy    User?           @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  refunds      PaymentRefund[]

  @@index([eventId])
  @@index([registrationId])
  @@index([registrationRef])
  @@index([createdByUserId])
  @@map("payments")
}

// Manual refunds are recorded once sent; providers add `PENDING` and `FAILED`.
enum PaymentRefundStatus {
  REFUNDED
}

// A fee going back to a registrant — not an expense of type `REFUND`.
model PaymentRefund {
  id                 String              @id @unique() @default(ulid()) @db.Char(26)
  paymentId          String              @map("payment_id") @db.Char(26)
  status             PaymentRefundStatus @default(REFUNDED)
  amount             Int
  refundedOn         String              @map("refunded_on") @db.Char(10)
  reason             String?             @db.VarChar(255)
  // What this refund took off the amount due (a cancellation); none for an
  // overpayment. Derived, so deleting the refund gives it back.
  amountDueReduction Int                 @default(0) @map("amount_due_reduction")
  createdByUserId    String?             @map("created_by_user_id") @db.Char(26)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime?           @updatedAt @map("updated_at")

  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy User?   @relation("PaymentRefundCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([paymentId])
  @@index([createdByUserId])
  @@map("payment_refunds")
}

model Message {
  id           String   @id @unique() @default(ulid()) @db.Char(26)
  eventId      String   @map("event_id") @db.Char(26)
  sentByUserId String?  @map("sent_by_user_id") @db.Char(26)
  priority     String   @default("normal")
  replyTo      String?  @map("reply_to")
  subject      String
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sentBy      User?             @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)
  deliveries  MessageDelivery[]
  attachments File[]

  @@index([sentByUserId])
  @@map("messages")
}

// A single per-recipient rendered email produced from a Message (ad-hoc send)
// or a MessageTemplate (automated event template).
model MessageDelivery {
  id                  String    @id @unique() @default(ulid()) @db.Char(26)
  templateId          String?   @map("message_template_id") @db.Char(26)
  messageId           String?   @map("message_id") @db.Char(26)
  registrationId      String    @map("registration_id") @db.Char(26)
  // Shared by the per-address deliveries of one send to a registration.
  batchId             String?   @map("batch_id") @db.Char(26)
  to                  String?   @db.VarChar(255)
  cc                  String?   @db.VarChar(255)
  bcc                 String?   @db.VarChar(255)
  replyTo             String?   @map("reply_to")
  subject             String
  body                String
  priority            String    @default("normal")
  createdAt           DateTime  @default(now()) @map("created_at")
  // The rendered email's Message-ID, doubling as the DSN ENVID a bounce
  // report is matched on. Not to be confused with `messageId` (the FK above).
  bounceCorrelationId String?   @unique @map("bounce_correlation_id")
  bouncedAt           DateTime? @map("bounced_at")
  bounceReason        String?   @map("bounce_reason")

  template     MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  message      Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  // The durable owner: template and message are severed by their own deletions,
  // so the registration is the only link that lives as long as the row. Erasing
  // it — or the event above it — takes the mails rendered about that
  // participant, which is what makes them erasable at all.
  registration Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  attachments  File[]

  @@map("message_deliveries")
}

// Reusable, automated template keyed by a trigger event (and optional country).
model MessageTemplate {
  id        String    @id @unique() @default(ulid()) @db.Char(26)
  eventId   String    @map("event_id") @db.Char(26)
  // The group the template is for, by its country code; null for every group.
  group     String?
  trigger   String
  priority  String    @default("normal")
  replyTo   String?   @map("reply_to")
  subject   String
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deliveries  MessageDelivery[]
  attachments File[]

  @@unique([group, trigger, eventId])
  @@map("message_templates")
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Job {
  id         String    @id @unique() @default(ulid()) @db.Char(26)
  name       String    @db.VarChar(255)
  queue      String    @db.VarChar(255)
  payload    Json
  status     JobStatus @default(PENDING)
  priority   Int       @default(1) @db.SmallInt
  attempts   Int       @default(0)
  error      String?
  runAt      DateTime? @map("run_at")
  reservedAt DateTime? @map("reserved_at")
  finishedAt DateTime? @map("finished_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([status, runAt])
