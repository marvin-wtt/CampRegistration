  eventId String @map("event_id") @db.Char(26)
  date    String @db.Char(10)
  plan    String @default("both")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([eventId, date])
  @@map("program_published_days")
