generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// TODO This is a workaround due to https://github.com/prisma/prisma/issues/3219
generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String    @id @unique(map: "users_id_unique") @default(ulid()) @db.Char(26)
  name          String    @db.VarChar(255)
  email         String    @unique(map: "users_email_unique") @db.VarChar(255)
  emailVerified Boolean   @default(false) @map("email_verified")
  password      String    @db.VarChar(255)
  role          Role      @default(USER)
  locale        String    @default("en-US") @db.VarChar(5)
  locked        Boolean   @default(false)
  lastSeen      DateTime? @map("last_seen")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  eventRoles             EventManager[]
  tokens                 Token[]
  newsletterManagers     NewsletterManager[]
  sentNewsletterMessages NewsletterMessage[]
  sentMessages           Message[]
  organizationMembers    OrganizationMember[]
  reviewedOrganizations  Organization[]       @relation("OrganizationReviewer")
  twoFactor              UserTwoFactor?

  @@map("users")
}

model UserTwoFactor {
  userId         String    @id @map("user_id") @db.Char(26)
  secret         String    @db.Char(32)
  /// Set once the user confirmed the setup with a valid code; null while
  /// setup is pending.
  confirmedAt    DateTime? @map("confirmed_at")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "user_two_factor_user_id_foreign")
  recoveryCodes TwoFactorRecoveryCode[]

  @@map("user_two_factor")
}

model TwoFactorRecoveryCode {
  id        String    @id @unique(map: "two_factor_recovery_codes_id_unique") @default(ulid()) @db.Char(26)
  userId    String    @map("user_id") @db.Char(26)
  code      String    @db.VarChar(255)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  twoFactor UserTwoFactor @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade, map: "two_factor_recovery_codes_user_id_foreign")

  @@index([userId], map: "two_factor_recovery_codes_user_id_index")
  @@map("two_factor_recovery_codes")
}

enum Role {
  USER
  ADMIN
}

enum ConfirmationMode {
  AUTOMATIC
  MANUAL
}

enum OrganizationVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Organization {
  id                 String                         @id @unique(map: "organizations_id_unique") @default(ulid()) @db.Char(26)
  name               String                         @db.VarChar(255)
  verificationStatus OrganizationVerificationStatus @default(PENDING) @map("verification_status")

  contactEmail       String  @map("contact_email") @db.VarChar(255)
  phone              String? @db.VarChar(50)
  website            String? @db.VarChar(255)
  registrationNumber String? @map("registration_number") @db.VarChar(100)

  addressStreet  String @map("address_street") @db.VarChar(255)
  addressZipCode String @map("address_zip_code") @db.VarChar(20)
  addressCity    String @map("address_city") @db.VarChar(255)
  country        String @db.Char(2)

  verificationNote String?   @map("verification_note") @db.Text
  reviewNote       String?   @map("review_note") @db.Text
  reviewedAt       DateTime? @map("reviewed_at")
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Char(26)
  submittedAt      DateTime  @default(now()) @map("submitted_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  reviewedBy  User?                    @relation("OrganizationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "organizations_reviewed_by_user_id_foreign")
  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  events      Event[]
  newsletters Newsletter[]

  @@index([verificationStatus], map: "organizations_verification_status_index")
  @@index([reviewedByUserId], map: "organizations_reviewed_by_user_id_index")
  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @unique(map: "organization_members_id_unique") @default(ulid()) @db.Char(26)
  organizationId String   @map("organization_id") @db.Char(26)
  userId         String?  @map("user_id") @db.Char(26)
  role           String   @default("MEMBER") @db.VarChar(50)
  invitationId   String?  @map("invitation_id") @db.Char(26)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "organization_members_organization_id_foreign")
  user         User?                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "organization_members_user_id_foreign")
  invitation   OrganizationInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "organization_members_invitation_id_foreign")

  @@unique([organizationId, userId], map: "organization_members_organization_id_user_id_unique")
  @@index([userId], map: "organization_members_user_id_index")
  @@index([invitationId], map: "organization_members_invitation_id_index")
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String @id @unique(map: "organization_invitations_id_unique") @default(ulid()) @db.Char(26)
  organizationId String @map("organization_id") @db.Char(26)
  email          String @db.VarChar(255)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "organization_invitations_organization_id_foreign")
  members      OrganizationMember[]

  @@index([organizationId], map: "organization_invitations_organization_id_index")
  @@index([email], map: "organization_invitations_email_index")
  @@map("organization_invitations")
}

model Event {
  id                      String           @id @unique(map: "events_id_unique") @default(ulid()) @db.Char(26)
  organizationId          String           @map("organization_id") @db.Char(26)
  listed                  Boolean
  registrationOpensAt     DateTime?        @map("registration_opens_at") @db.DateTime(0)
  registrationClosesAt    DateTime?        @map("registration_closes_at") @db.DateTime(0)
  confirmationMode        ConfirmationMode @default(AUTOMATIC) @map("confirmation_mode")
  /// ![Array<string>]
  countries               Json             @db.Json
  /// ![string | Record<string, string>]
  name                    Json             @db.Json
  /// ![string | Record<string, string>]
  organizer               Json             @db.Json
  /// ![string | Record<string, string>]
  contactEmail            Json             @map("contact_email") @db.Json
  /// ![number | Record<string, number>]
  maxParticipants         Json             @map("max_participants") @db.Json
  minAge                  Int              @map("min_age") @db.UnsignedInt
  maxAge                  Int              @map("max_age") @db.UnsignedInt
  startAt                 DateTime         @map("start_at") @db.DateTime(0)
  endAt                   DateTime         @map("end_at") @db.DateTime(0)
  price                   Float
  /// ![string | Record<string, string>]
  location                Json?            @db.Json
  /// ![Record<string, unknown>]
  form                    Json             @db.Json
  /// ![Record<string, unknown>]
  themes                  Json             @default("{}") @db.Json
  retentionReminderSentAt DateTime?        @map("retention_reminder_sent_at")
  createdAt               DateTime?        @default(now()) @map("created_at")
  updatedAt               DateTime?        @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "events_organization_id_foreign")
  eventManager     EventManager[]
  registrations    Registration[]
  rooms            Room[]
  tableTemplates   TableTemplate[]
  messageTemplates MessageTemplate[]
  messages         Message[]
  files            File[]
  programItems     ProgramItem[]
  tasks            Task[]
  chores           Chore[]
  choreAssignments ChoreAssignment[]
  eventSettings    EventSetting[]

  @@index([organizationId], map: "events_organization_id_index")
  @@map("events")
}

model EventManager {
  id           String    @id @unique(map: "event_managers_id_unique") @default(ulid()) @db.Char(26)
  eventId      String    @map("event_id") @db.Char(26)
  userId       String?   @map("user_id") @db.Char(26)
  role         String    @db.VarChar(50)
  invitationId String?   @map("invitation_id") @db.Char(26)
  expiresAt    DateTime? @map("expires_at") @db.DateTime(0)

  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "event_managers_event_id_foreign")
  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "event_managers_user_id_foreign")
  invitation    Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "event_managers_invitation_id_foreign")
  assignedTasks Task[]

  @@index([eventId], map: "event_managers_event_id_foreign")
  @@index([userId], map: "event_managers_user_id_foreign")
  @@index([invitationId], map: "event_manager_invitation_id_foreign")
  @@map("event_managers")
}

model Invitation {
  id           String         @id @unique(map: "invitations_id_unique") @default(ulid()) @db.Char(26)
  email        String         @db.VarChar(255)
  eventManager EventManager[]

  @@map("event_manager_invitations")
}

enum RegistrationStatus {
  ACCEPTED
  PENDING
  WAITLISTED
}

model Registration {
  id                                 String             @id @unique(map: "registrations_id_unique") @default(ulid()) @db.Char(26)
  eventId                            String             @map("event_id") @db.Char(26)
  /// ![Record<string, unknown>]
  data                               Json               @db.Json
  /// ![Record<string, unknown>]
  customData                         Json?              @map("custom_data") @db.Json
  // Computed fields
  firstName                          String?            @map("first_name")
  lastName                           String?            @map("last_name")
  role                               String?
  gender                             String?
  dateOfBirth                        DateTime?          @map("date_of_birth") @db.Date
  /// ![Array<string>]
  emails                             Json?
  street                             String?
  city                               String?
  zipCode                            String?            @map("zip_code")
  country                            String?
  newsletterConsent                  Boolean?           @map("newsletter_consent")
  locale                             String             @default("en-US") @db.VarChar(5)
  //
  status                             RegistrationStatus @default(PENDING)
  // Which privacy information this person was actually shown. Nullable because
  // registrations predating the feature were shown none — do not backfill.
  organizationPrivacyNoticeVersionId String?            @map("organization_privacy_notice_version_id") @db.Char(26)
  eventPrivacyNoticeVersionId        String?            @map("event_privacy_notice_version_id") @db.Char(26)
  platformPrivacyPolicyUpdatedAt     DateTime?          @map("platform_privacy_policy_updated_at")
  createdAt                          DateTime           @default(now()) @map("created_at")
  updatedAt                          DateTime?          @updatedAt @map("updated_at")

  event                     Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "registrations_event_id_foreign")
  organizationPrivacyNotice PrivacyNoticeVersion? @relation("RegistrationOrganizationPrivacyNotice", fields: [organizationPrivacyNoticeVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "registrations_organization_privacy_notice_version_id_foreign")
  eventPrivacyNotice        PrivacyNoticeVersion? @relation("RegistrationEventPrivacyNotice", fields: [eventPrivacyNoticeVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "registrations_event_privacy_notice_version_id_foreign")
  bed                       Bed?
  files                     File[]
  deliveries                MessageDelivery[]
  choreAssignmentMembers    ChoreAssignmentMember[]

  @@index([organizationPrivacyNoticeVersionId], map: "registrations_organization_privacy_notice_version_id_index")
  @@index([eventPrivacyNoticeVersionId], map: "registrations_event_privacy_notice_version_id_index")
  @@map("registrations")
}

model Room {
  id        String @id @unique(map: "rooms_id_unique") @default(ulid()) @db.Char(26)
  eventId   String @map("event_id") @db.Char(26)
  /// ![string | Record<string, string>]
  name      Json   @db.Json
  sortOrder Int    @default(999) @map("sort_order")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "rooms_event_id_foreign")
  beds  Bed[]

  @@map("rooms")
}

model Bed {
  id             String  @id @unique @default(ulid()) @db.Char(26)
  roomId         String  @map("room_id") @db.Char(26)
  registrationId String? @unique(map: "beds_registration_id_unique") @map("registration_id") @db.Char(26)

  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "beds_room_id_foreign")
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "beds_registration_id_foreign")

  @@map("beds")
}

model TableTemplate {
  id      String @id @unique(map: "table_templates_id_unique") @default(ulid()) @db.Char(26)
  eventId String @map("event_id") @db.Char(26)
  /// ![Record<string, unknown>]
  data    Json   @db.Json

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "table_templates_event_id_foreign")

  @@index([eventId], map: "table_templates_event_id_foreign")
  @@map("table_templates")
}

model EventSetting {
  id        String    @id @unique(map: "event_settings_id_unique") @default(ulid()) @db.Char(26)
  eventId   String    @map("event_id") @db.Char(26)
  key       String    @db.VarChar(100)
  /// ![Record<string, unknown>]
  data      Json      @db.Json
  updatedAt DateTime? @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "event_settings_event_id_foreign")

  @@unique([eventId, key], map: "event_settings_event_id_key_unique")
  @@map("event_settings")
}

model Token {
  id          Int       @id @default(autoincrement())
  userId      String    @map("user_id") @db.Char(26)
  token       String    @db.Char(255)
  type        TokenType
  expiresAt   DateTime  @map("expires_at")
  blacklisted Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
  RESTRICTED_ACCESS
}

enum UploadStatus {
  PENDING
  READY
}

model File {
  id                  String       @id @unique(map: "files_id_unique") @default(ulid()) @db.Char(26)
  eventId             String?      @map("event_id") @db.Char(26) // Prisma does not support morth
  registrationId      String?      @map("registration_id") @db.Char(26) // Prisma does not support morth
  messageId           String?      @map("message_id") @db.Char(26) // Prisma does not support morth
  messageDeliveryId   String?      @map("message_delivery_id") @db.Char(26) // Prisma does not support morth
  messageTemplateId   String?      @map("message_template_id") @db.Char(26) // Prisma does not support morth
  newsletterMessageId String?      @map("newsletter_message_id") @db.Char(26) // Prisma does not support morth
  name                String
  originalName        String       @map("original_name")
  field               String?
  locale              String?
  type                String
  size                Int
  accessLevel         String?      @map("access_level")
  storageLocation     String       @map("storage_location")
  uploadStatus        UploadStatus @default(READY) @map("upload_status")
  encryption          String?
  createdAt           DateTime     @default(now()) @map("created_at")

  event             Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  registration      Registration?      @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  message           Message?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  messageDelivery   MessageDelivery?   @relation(fields: [messageDeliveryId], references: [id], onDelete: SetNull)
  messageTemplate   MessageTemplate?   @relation(fields: [messageTemplateId], references: [id], onDelete: SetNull)
  newsletterMessage NewsletterMessage? @relation(fields: [newsletterMessageId], references: [id], onDelete: SetNull)

  @@map("files")
}

model Message {
  id           String   @id @unique(map: "message_id_unique") @default(ulid()) @db.Char(26)
  eventId      String   @map("event_id") @db.Char(26)
  sentByUserId String?  @map("sent_by_user_id") @db.Char(26)
  priority     String   @default("normal")
  replyTo      String?  @map("reply_to")
  subject      String   @db.Text
  body         String   @db.LongText
  createdAt    DateTime @default(now()) @map("created_at")

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sentBy      User?             @relation(fields: [sentByUserId], references: [id], onDelete: SetNull, map: "messages_sent_by_user_id_foreign")
  deliveries  MessageDelivery[]
  attachments File[]

  @@index([sentByUserId], map: "messages_sent_by_user_id_index")
  @@map("messages")
}

// A single per-recipient rendered email produced from a Message (ad-hoc send)
// or a MessageTemplate (automated event template).
model MessageDelivery {
  id             String   @id @unique(map: "message_delivery_id_unique") @default(ulid()) @db.Char(26)
  templateId     String?  @map("message_template_id") @db.Char(26)
  messageId      String?  @map("message_id") @db.Char(26)
  registrationId String   @map("registration_id") @db.Char(26)
  to             String?  @db.TinyText
  cc             String?  @db.TinyText
  bcc            String?  @db.TinyText
  replyTo        String?  @map("reply_to")
  subject        String   @db.MediumText
  body           String   @db.MediumText
  priority       String   @default("normal")
  createdAt      DateTime @default(now()) @map("created_at")

  template     MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  message      Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  // The durable owner: template and message are severed by their own deletions,
  // so the registration is the only link that lives as long as the row. Erasing
  // it — or the event above it — takes the mails rendered about that
  // participant, which is what makes them erasable at all.
  registration Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  attachments  File[]

  @@map("message_deliveries")
}

// Reusable, automated template keyed by a trigger event (and optional country).
model MessageTemplate {
  id        String    @id @unique(map: "message_template_id_unique") @default(ulid()) @db.Char(26)
  eventId   String    @map("event_id") @db.Char(26)
  country   String?
  trigger   String
  priority  String    @default("normal")
  replyTo   String?   @map("reply_to")
  subject   String    @db.Text
  body      String    @db.LongText
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deliveries  MessageDelivery[]
  attachments File[]

  @@unique([country, trigger, eventId], map: "message_templates_country_trigger_event_id_unique")
  @@map("message_templates")
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Job {
  id         String    @id @unique(map: "jobs_id_unique") @default(ulid()) @db.Char(26)
  name       String    @db.VarChar(255)
  queue      String    @db.VarChar(255)
  payload    Json      @db.Json
  status     JobStatus @default(PENDING)
  priority   Int       @default(1) @db.UnsignedTinyInt
  attempts   Int       @default(0)
  error      String?   @db.Text
  runAt      DateTime? @map("run_at") @db.DateTime(3)
  reservedAt DateTime? @map("reserved_at") @db.DateTime(3)
  finishedAt DateTime? @map("finished_at") @db.DateTime(3)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([status, runAt], map: "jobs_status_run_at_index")
  @@map("jobs")
}

model JobRateLimit {
  queue      String   @id @unique(map: "queue_unique") @db.VarChar(255)
  tokens     Float
  refilledAt DateTime @map("refilled_at") @db.DateTime(3)

  @@map("job_rate_limits")
}

model Newsletter {
  id             String    @id @unique(map: "newsletters_id_unique") @default(ulid()) @db.Char(26)
  organizationId String    @map("organization_id") @db.Char(26)
  name           String    @db.VarChar(255)
  description    String?   @db.Text
  replyTo        String?   @map("reply_to") @db.Char(255)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "newsletters_organization_id_foreign")
  managers     NewsletterManager[]
  subscribers  NewsletterSubscriber[]
  messages     NewsletterMessage[]

  @@index([organizationId], map: "newsletters_organization_id_index")
  @@map("newsletters")
}

model NewsletterManager {
  id           String @id @unique(map: "newsletter_managers_id_unique") @default(ulid()) @db.Char(26)
  newsletterId String @map("newsletter_id") @db.Char(26)
  userId       String @map("user_id") @db.Char(26)
  role         String @default("OWNER") @db.VarChar(50)

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "newsletter_managers_newsletter_id_foreign")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "newsletter_managers_user_id_foreign")

  @@unique([newsletterId, userId], map: "newsletter_managers_newsletter_id_user_id_unique")
  @@index([newsletterId], map: "newsletter_managers_newsletter_id_index")
  @@index([userId], map: "newsletter_managers_user_id_index")
  @@map("newsletter_managers")
}

model NewsletterSubscriber {
  id               String   @id @unique(map: "newsletter_subscribers_id_unique") @default(ulid()) @db.Char(26)
  newsletterId     String   @map("newsletter_id") @db.Char(26)
  email            String   @db.VarChar(255)
  name             String?  @db.VarChar(255)
  unsubscribeToken String   @unique(map: "newsletter_subscribers_unsubscribe_token_unique") @map("unsubscribe_token") @db.Char(64)
  subscribedAt     DateTime @default(now()) @map("subscribed_at")

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "newsletter_subscribers_newsletter_id_foreign")

  @@unique([newsletterId, email], map: "newsletter_subscribers_newsletter_id_email_unique")
  @@index([newsletterId], map: "newsletter_subscribers_newsletter_id_index")
  @@map("newsletter_subscribers")
}

model NewsletterMessage {
  id             String   @id @unique(map: "newsletter_messages_id_unique") @default(ulid()) @db.Char(26)
  newsletterId   String   @map("newsletter_id") @db.Char(26)
  sentByUserId   String?  @map("sent_by_user_id") @db.Char(26)
  subject        String   @db.VarChar(255)
  body           String   @db.Text
  recipientCount Int      @map("recipient_count")
  sentAt         DateTime @default(now()) @map("sent_at")

  newsletter  Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "newsletter_messages_newsletter_id_foreign")
  sentBy      User?      @relation(fields: [sentByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "newsletter_messages_sent_by_user_id_foreign")
  attachments File[]

  @@index([newsletterId], map: "newsletter_messages_newsletter_id_index")
  @@map("newsletter_messages")
}

model ProgramItem {
  id       String  @id @unique(map: "program_item_id_unique") @default(ulid()) @db.Char(26)
  eventId  String  @map("event_id") @db.Char(26) // Prisma does not support morth
  /// ![string | Record<string, string>]
  title    Json
  /// ![string | Record<string, string>]
  details  Json?
  /// ![string | Record<string, string>]
  location Json?
  date     String?
  duration Int?
  time     String?
  color    String? @map("color")
  plan     String  @default("both")
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("program_items")
}

model Task {
  id         String  @id @unique(map: "tasks_id_unique") @default(ulid()) @db.Char(26)
  eventId    String  @map("event_id") @db.Char(26)
  title      String
  notes      String? @db.Text
  dueDate    String? @map("due_date")
  completed  Boolean @default(false)
  assigneeId String? @map("assignee_id") @db.Char(26)

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "tasks_event_id_foreign")
  assignee EventManager? @relation(fields: [assigneeId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "tasks_assignee_id_foreign")

  @@index([eventId], map: "tasks_event_id_foreign")
  @@index([assigneeId], map: "tasks_assignee_id_foreign")
  @@map("tasks")
}

enum ChoreRotationUnit {
  PARTICIPANT
  ROOM
}

model Chore {
  id      String @id @unique(map: "chores_id_unique") @default(ulid()) @db.Char(26)
  eventId String @map("event_id") @db.Char(26)
  /// ![string | Record<string, string>]
  name      Json @db.Json
  sortOrder Int  @default(999) @map("sort_order")
  /// Usual number of units (participants or rooms, whichever the occurrence
  /// is assigned by) this chore needs. Not enforced — staff can add or remove
  /// members freely; it only sizes the suggestion.
  defaultCount     Int?    @map("default_count") @db.UnsignedInt
  /// Exclude staff (and rooms with no participant occupants) from suggestions.
  excludeStaff     Boolean @default(false) @map("exclude_staff")
  /// Nice-to-have: try to spread suggested participants across countries.
  /// Only ever a secondary tiebreak — fairness (least/oldest assigned) always
  /// wins first.
  balanceCountries Boolean @default(false) @map("balance_countries")

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "chores_event_id_foreign")
  assignments ChoreAssignment[]

  @@index([eventId], map: "chores_event_id_foreign")
  @@map("chores")
}

model ChoreAssignment {
  id      String @id @unique(map: "chore_assignments_id_unique") @default(ulid()) @db.Char(26)
  eventId String @map("event_id") @db.Char(26)
  choreId String @map("chore_id") @db.Char(26)
  /// Chosen per occurrence, not fixed on the chore — the same chore can be
  /// covered by individuals one day and by a whole room the next.
  rotationUnit ChoreRotationUnit @map("rotation_unit")
  /// YYYY-MM-DD
  date      String   @db.VarChar(10)
  slot      String?
  createdAt DateTime @default(now()) @map("created_at")

  event   Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "chore_assignments_event_id_foreign")
  chore   Chore                   @relation(fields: [choreId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "chore_assignments_chore_id_foreign")
  members ChoreAssignmentMember[]

  @@index([eventId], map: "chore_assignments_event_id_foreign")
  @@index([choreId], map: "chore_assignments_chore_id_foreign")
  @@map("chore_assignments")
}

model ChoreAssignmentMember {
  id                String @id @unique(map: "chore_assignment_members_id_unique") @default(ulid()) @db.Char(26)
  choreAssignmentId String @map("chore_assignment_id") @db.Char(26)
  registrationId    String @map("registration_id") @db.Char(26)

  choreAssignment ChoreAssignment @relation(fields: [choreAssignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "chore_assignment_members_chore_assignment_id_foreign")
  registration    Registration    @relation(fields: [registrationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "chore_assignment_members_registration_id_foreign")

  @@unique([choreAssignmentId, registrationId], map: "chore_assignment_members_unique")
  @@index([registrationId], map: "chore_assignment_members_registration_id_foreign")
  @@map("chore_assignment_members")
}

enum LegalDocumentType {
  IMPRINT
  PRIVACY_POLICY
}

model LegalDocument {
  id        String            @id @unique(map: "legal_documents_id_unique") @default(ulid()) @db.Char(26)
  type      LegalDocumentType @unique(map: "legal_documents_type_unique")
  /// ![string | Record<string, string>]
  content   Json?             @db.Json
  updatedAt DateTime?         @updatedAt @map("updated_at")

  @@map("legal_documents")
}

enum PrivacyNoticeScope {
  ORGANIZATION
  EVENT
}

/// Append-only. A registration points at the exact version it was shown, so an
/// organization can still prove what the notice said months later.
model PrivacyNoticeVersion {
  id      String             @id @unique(map: "privacy_notice_versions_id_unique") @default(ulid()) @db.Char(26)
  scope   PrivacyNoticeScope
  scopeId String             @map("scope_id") @db.Char(26)
  version Int
  /// ![PrivacyNoticeContent]
  content Json               @db.Json

  publishedAt DateTime @default(now()) @map("published_at")

  registrationsAsOrganization Registration[] @relation("RegistrationOrganizationPrivacyNotice")
  registrationsAsEvent        Registration[] @relation("RegistrationEventPrivacyNotice")

  @@unique([scope, scopeId, version], map: "privacy_notice_versions_scope_scope_id_version_unique")
  @@index([scope, scopeId], map: "privacy_notice_versions_scope_scope_id_index")
  @@map("privacy_notice_versions")
}
