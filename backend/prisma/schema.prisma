}

enum ChoreRotationUnit {
  PERSON
  ROOM
}

enum ChoreEligibility {
  PARTICIPANTS
  STAFF
  EVERYONE
}

enum ChoreEffort {
  LIGHT
  NORMAL
  HEAVY
}

enum ChoreAssignmentStatus {
  PLANNED
  DONE
  CANCELLED
}

enum ChoreMemberRole {
  MEMBER
  SUPERVISOR
}

model Chore {
  id      String @id @unique() @default(ulid()) @db.Char(26)
  eventId String @map("event_id") @db.Char(26)
  /// ![string | Record<string, string>]
  name    Json

  sortOrder           Int               @default(999) @map("sort_order")
  defaultCount        Int?              @map("default_count")
  supervisorCount     Int               @default(0) @map("supervisor_count")
  eligibility         ChoreEligibility  @default(PARTICIPANTS)
  effort              ChoreEffort       @default(NORMAL)
  defaultRotationUnit ChoreRotationUnit @default(PERSON) @map("default_rotation_unit")
  balanceGroups       Boolean           @default(false) @map("balance_groups")

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  slots       ChoreSlot[]
  assignments ChoreAssignment[]

  @@index([eventId])
  @@map("chores")
}

model ChoreSlot {
  id              String       @id @unique() @default(ulid()) @db.Char(26)
  choreId         String       @map("chore_id") @db.Char(26)
  /// ![string | Record<string, string>]
  name            Json
  sortOrder       Int          @default(0) @map("sort_order")
  headcount       Int?
  supervisorCount Int?         @map("supervisor_count")
  effort          ChoreEffort?

  chore       Chore             @relation(fields: [choreId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignments ChoreAssignment[]

  @@index([choreId])
  @@map("chore_slots")
}

model ChoreAssignment {
  id              String                @id @unique() @default(ulid()) @db.Char(26)
  eventId         String                @map("event_id") @db.Char(26)
  choreId         String                @map("chore_id") @db.Char(26)
  slotId          String?               @map("slot_id") @db.Char(26)
  batchId         String?               @map("batch_id") @db.Char(26)
  rotationUnit    ChoreRotationUnit     @map("rotation_unit")
  date            DateTime              @db.Date
  /// Legacy free-text slot, superseded by `slotId`. Drop in the next release.
  slot            String?
  status          ChoreAssignmentStatus @default(PLANNED)
  note            String?               @db.VarChar(500)
  /// This duty's own counts; null inherits the slot's, then the chore's.
  headcount       Int?
  supervisorCount Int?                  @map("supervisor_count")
  createdAt       DateTime              @default(now()) @map("created_at")

  event     Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chore     Chore                   @relation(fields: [choreId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  choreSlot ChoreSlot?              @relation(fields: [slotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  members   ChoreAssignmentMember[]

  @@index([eventId])
  @@index([choreId])
  @@index([slotId])
  @@index([batchId])
  @@map("chore_assignments")
}

model ChoreAssignmentMember {
  id                String          @id @unique() @default(ulid()) @db.Char(26)
  choreAssignmentId String          @map("chore_assignment_id") @db.Char(26)
  registrationId    String          @map("registration_id") @db.Char(26)
  role              ChoreMemberRole @default(MEMBER)
  missed            Boolean         @default(false)

  choreAssignment ChoreAssignment @relation(fields: [choreAssignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  registration    Registration    @relation(fields: [registrationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([choreAssignmentId, registrationId])
  @@index([registrationId])
  @@map("chore_assignment_members")
}

enum LegalDocumentType {
  IMPRINT
  PRIVACY_POLICY
}

model LegalDocument {
  id        String            @id @unique() @default(ulid()) @db.Char(26)
  type      LegalDocumentType @unique()
  /// ![string | Record<string, string>]
  content   Json?
  updatedAt DateTime?         @updatedAt @map("updated_at")

  @@map("legal_documents")
}

enum PrivacyNoticeScope {
  ORGANIZATION
  EVENT
}

/// Append-only. A registration points at the exact version it was shown, so an
/// organization can still prove what the notice said months later.
model PrivacyNoticeVersion {
  id      String             @id @unique() @default(ulid()) @db.Char(26)
  scope   PrivacyNoticeScope
  scopeId String             @map("scope_id") @db.Char(26)
  version Int
  /// ![PrivacyNoticeContent]
  content Json

  publishedAt DateTime @default(now()) @map("published_at")

  registrationsAsOrganization Registration[] @relation("RegistrationOrganizationPrivacyNotice")
  registrationsAsEvent        Registration[] @relation("RegistrationEventPrivacyNotice")

  @@unique([scope, scopeId, version])
  @@index([scope, scopeId])
  @@map("privacy_notice_versions")
}

model AuditLog {
  id         String   @id @unique() @default(ulid()) @db.Char(26)
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.Char(26)
  eventId    String?  @map("event_id") @db.Char(26)
  actorId    String?  @map("actor_id") @db.Char(26)
  /// ![{ changedFields?: Array<string>; values?: Record<string, string | number | boolean | null>; context?: Record<string, string | number | boolean | null>; reason?: string; subjectId?: string | null; subjectHint?: string }]
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([eventId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

/// Name of a deleted account, so the audit log keeps naming who acted.
/// Purged after the audit retention window.
model AuditDeletedUser {
  id        String   @id @db.Char(26)
  name      String   @db.VarChar(255)
  deletedAt DateTime @default(now()) @map("deleted_at")

  @@index([deletedAt])
  @@map("audit_deleted_users")
}

/// Mirrors `EVENT_RETENTION_DEADLINE_KINDS` (common/src/privacy).
enum EventRetentionDeadlineKind {
  sensitive
  registrations
}

/// What an event's deadline of one kind cannot be computed from: its
/// postponement and the reminders sent (docs/privacy.md, 8). The deadline
/// itself is derived from the stamped notices whenever it is needed. Dates are
/// calendar dates (`YYYY-MM-DD`) in the event's time zone.
model EventRetentionState {
  id             String                     @id @default(ulid()) @db.Char(26)
  eventId        String                     @map("event_id") @db.Char(26)
  kind           EventRetentionDeadlineKind
  postponedUntil String?                    @map("postponed_until") @db.Char(10)
  postponeReason String?                    @map("postpone_reason")
  postponedAt    DateTime?                  @map("postponed_at") @db.Timestamp(0)
  postponedById  String?                    @map("postponed_by_id") @db.Char(26)
  /// The deadline the last reminder was for: a moved deadline is reminded anew.
  remindedFor    String?                    @map("reminded_for") @db.Char(10)
  /// The most urgent stage sent for `remindedFor` (days before).
  remindedStage  Int?                       @map("reminded_stage")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  postponedBy User? @relation("EventRetentionStatePostponedBy", fields: [postponedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([eventId, kind])
  @@map("event_retention_states")
}
