{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "bootstrap-sha": "5f8205113799e1e435ec65905b3b8f03bdea5add",
  "packages": {
    ".": {
      "package-name": "camp-registration",
      "skip-changelog": true,
      "extra-files": [
        {
          "type": "json",
          "path": "common/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "backend/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "frontend/package.json",
          "jsonpath": "$.version"
        },
        { "type": "json", "path": "e2e/package.json", "jsonpath": "$.version" },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages.common.version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages.backend.version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages.frontend.version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages.e2e.version"
        }
      ]
    }
  }
}
