{
  "name": "camp-registration",
  "version": "1.0.0",
  "scripts": {
    "prepare": "patch-package && husky",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "migrate": "npm run migrate --workspaces --if-present",
    "build-and-migrate": "run-s build migrate",
    "production": "npm run production --workspace backend"
  },
  "keywords": [],
  "author": "marvin-wtt <31454580+marvin-wtt@users.noreply.github.com>",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/marvin-wtt/CampRegistration"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "common",
    "backend",
    "frontend",
    "e2e"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.0.1"
  },
  "overrides": {
    "quasar": {
      "@types/express": "^5.0.0",
      "@types/express-serve-static-core": "^5.0.0"
    }
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.9.1": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true,
    "esbuild@0.25.12": true
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,vue,scss,html,md,json}": "prettier --write --ignore-unknown"
  }
}
