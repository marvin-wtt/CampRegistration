+// === Pickers in Menus ===
+// QDate, QTime and QColor draw their own surface and expect the container to
+// add only elevation (see QDate.scss). A QPopupProxy menu would otherwise frame
+// them with its padding and background, so the picker becomes the surface.
+.q-menu:has(> .q-date, > .q-time) {
+  padding: 0;
+  border-radius: $md3-corner-extra-large;
+  background: transparent;
+}
